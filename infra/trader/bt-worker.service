[Unit]
Description=Market Hub back-tests (trader/bt_worker.py): queued back-tests from the dashboard, outside market hours
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/opt/trader/app
EnvironmentFile=/opt/trader/secrets/bt.env
Environment=BT_CACHE=/opt/trader/btcache
Environment=TZ=Asia/Kolkata
ExecStart=/opt/trader/venv/bin/python -u -m trader.bt_worker
Restart=always
RestartSec=30
Nice=10

[Install]
WantedBy=multi-user.target
